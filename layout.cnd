directives:
  - flag: hideDisconnectedBuiltIns
  - flag: hideDisconnectedAtoms

  - hideAtom: {selector: StormTrue}
  - hideAtom: {selector: StormFalse}

  - hideField: {field: parentBeats}
  - hideField: {field: backupBeats}
  - hideField: {field: originatesInfo}
  - hideField: {field: lostOriginator}
  - hideField: {field: failed}

  - attribute: {field: stormInfo}

  - edge: {field: parent}
  - edge: {field: passStormComing}
  - edge: {field: backup}

  - size: {width: 120, height: 60, selector: Station}